#!/usr/bin/env python3
"""Validate listing copy, native capture dimensions, and Index upload assets."""
import argparse
from pathlib import Path
import struct
import re

ROOT = Path(__file__).resolve().parents[1]
def validate(root):
    errors = []
    def check(condition, message):
        if not condition:
            errors.append(message)
    for face in ('mini-chrono', 'mini-lingua', 'mini-glyphs', 'mini-index'):
        folder = root / face / 'store-assets'
        check((folder / 'README.md').is_file(), f'{face}: missing Store asset README.md')
        title = folder / 'title.txt'
        check(title.is_file() and bool(title.read_text().strip()), f'{face}: missing or empty title.txt')
        path = folder / 'description.txt'
        try:
            text = path.read_text()
            check(0 < len(text.strip()) and len(text) <= 4000,
                  f'{face}: description must contain 1–4000 characters')
            check(list(path.parent.glob('description*.txt')) == [path],
                  f'{face}: keep one canonical description.txt')
        except (OSError, UnicodeError) as error:
            errors.append(f'{path}: {error}')
    # Public copy and images should not carry local machine paths or identity.
    for path in root.glob('mini-*/store-assets/*'):
        if path.suffix not in ('.txt', '.png'):
            continue
        data = path.read_bytes()
        check(not re.search(rb'/Users/|/home/|[A-Za-z]:\\Users\\', data),
              f'{path.name}: contains an absolute user-directory path')
        for value in (str(ROOT), str(Path.home()), Path.home().name, ROOT.parent.name):
            if len(value) > 3:
                check(value.encode() not in data, f'{path.name}: contains local workspace/identity data')
        if path.suffix == '.png':
            offset = 8
            while offset + 12 <= len(data):
                length = struct.unpack('>I', data[offset:offset+4])[0]
                kind = data[offset+4:offset+8]
                check(kind not in (b'tEXt', b'zTXt', b'iTXt', b'eXIf'),
                      f'{path.name}: remove embedded text/EXIF metadata')
                offset += length + 12
    assets = root / 'mini-index/store-assets'
    dimensions = {'cover.png': (500, 500)}
    for variant in ('orange-none', 'sage-four', 'blue-twelve', 'lilac-none-date'):
        dimensions[f'screen-{variant}.png'] = (500, 524)
        dimensions[f'raw/venu3-{variant}.png'] = (454, 454)
    dimensions['raw/venusq2-orange-none.png'] = (320, 360)
    for name, expected in dimensions.items():
        path = assets / name
        try:
            data = path.read_bytes()
            valid = len(data) >= 24 and data[:8] == b'\x89PNG\r\n\x1a\n' and data[12:16] == b'IHDR'
            check(valid, f'{name}: invalid PNG header')
            if valid:
                check(struct.unpack('>II', data[16:24]) == expected,
                      f'{name}: expected dimensions {expected}')
            if not name.startswith('raw/'):
                limit = 300000 if name == 'cover.png' else 150000
                check(len(data) < limit, f'{name}: must be below {limit} bytes')
        except OSError as error:
            errors.append(f'{name}: {error}')
    return errors


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', type=Path, default=ROOT, help=argparse.SUPPRESS)
    args = parser.parse_args()
    errors = validate(args.root)
    if errors:
        raise SystemExit('\n'.join(errors))
    print('PASS: descriptions, PNG dimensions/size limits, and asset privacy checks.')


if __name__ == '__main__':
    main()
