#!/usr/bin/env python3
"""Check Mini Index support decisions and display profiles against Garmin metadata."""
import argparse
import json
from pathlib import Path
import re
import xml.etree.ElementTree as ET

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--devices', type=Path, default=Path.home() / 'Library/Application Support/Garmin/ConnectIQ/Devices')
args = parser.parse_args()
root = Path(__file__).resolve().parent.parent
manifest = ET.parse(root / 'mini-index/manifest.xml')
app = manifest.find('.//{*}application')
minimum = tuple(map(int, app.attrib['minApiLevel'].split('.')))
declared = {p.attrib['id'] for p in manifest.findall('.//{*}product')}
profiles = dict(re.findall(r'^([\w]+)\.excludeAnnotations\s*=\s*(.+)$', (root / 'mini-index/monkey.jungle').read_text(), re.M))
exclusions = json.loads((root / 'mini-index/device-exclusions.json').read_text())
if any(not isinstance(reason, str) or not reason.strip() for reason in exclusions.values()):
    raise SystemExit('Every device exclusion needs a concrete design or technical reason.')
eligible = set()
excluded = []
errors = []
for path in sorted(args.devices.glob('*/compiler.json')):
    device = json.loads(path.read_text())
    if not any(a['type'] == 'watchFace' for a in device['appTypes']):
        continue
    product = device['deviceId']
    versions = [tuple(map(int, part['connectIQVersion'].split('.'))) for part in device['partNumbers']]
    if max(versions) < minimum:
        excluded.append(product)
        continue
    eligible.add(product)
    simulator = json.loads((path.parent / 'simulator.json').read_text())
    physical_cutout = 'subscreen' in simulator and device['bitsPerPixel'] == 1
    if product in declared:
        if physical_cutout or 'analogHands' in simulator:
            errors.append(f'{product}: physical cutout or analog hands conflict with Index support policy; exclude this target')
        if simulator['display']['shape'] not in ('round', 'semi-round', 'rectangle'):
            errors.append(f'{product}: unreviewed display geometry; keep unsupported pending a design review')
    display = device['displayType']
    if display not in ('mip', 'amoled', 'lcd'):
        errors.append(f'{product}: unreviewed display type {display}')
        continue
    expected = {
        'amoled' if display == 'mip' else 'mip',
        'color' if device['bitsPerPixel'] == 1 else 'mono',
        # AMOLED subscreens are virtual and do not obstruct the dial.
        'fullScreen' if physical_cutout else 'cutout',
    }
    actual = set(profiles.get(product, '').split(';'))
    if product in declared and actual != expected:
        errors.append(f'{product}: expected excluded annotations {sorted(expected)}, got {sorted(actual)}')
if not eligible:
    errors.append(f'No compatible watch metadata found under {args.devices}')
for product in sorted(set(exclusions) - eligible):
    errors.append(f'{product}: exclusion missing or below minimum API in installed metadata')
for product in sorted(set(exclusions) & declared):
    errors.append(f'{product}: intentionally excluded watch still declared')
for product in sorted(eligible - declared - set(exclusions)):
    errors.append(f'{product}: unreviewed watch; document an exclusion or validate the existing layout before adding support')
for product in sorted(declared - eligible):
    errors.append(f'{product}: declared watch missing or below minimum API in installed metadata')
for product in sorted(set(profiles) - declared):
    errors.append(f'{product}: stale display profile outside manifest')
if errors:
    raise SystemExit('\n'.join(errors))
print(f'PASS: {len(declared)} supported watch product IDs have correct display profiles; {len(exclusions)} documented design exclusions.')
print('Design exclusions: ' + ', '.join(sorted(exclusions)))
print(f'Excluded below API {app.attrib["minApiLevel"]}: {", ".join(excluded)}')
