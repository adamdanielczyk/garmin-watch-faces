#!/usr/bin/env python3
"""Inspect decompressed Garmin export contents for private machine paths."""
import argparse
from pathlib import Path, PurePosixPath
import re
import shutil
import subprocess
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('packages', type=Path, nargs='+')
args = parser.parse_args()
archiver = shutil.which('bsdtar')
if not archiver:
    raise SystemExit('bsdtar is required to inspect the compressed .iq package.')
root = Path(__file__).resolve().parents[1]
private_strings = [str(Path.home()), str(root), Path.home().name, root.parent.name]
private_strings = [v for v in private_strings if len(v) > 3]
for package in args.packages:
    package = package.resolve()
    names = subprocess.check_output([archiver, '-tf', str(package)], text=True).splitlines()
    if any(PurePosixPath(n).is_absolute() or '..' in PurePosixPath(n).parts for n in names):
        raise SystemExit('Package contains an unsafe archive member path.')
    with tempfile.TemporaryDirectory(prefix='ciq-audit-', dir='/tmp') as directory:
        subprocess.run([archiver, '-xf', str(package), '-C', directory], check=True)
        files = [p for p in Path(directory).rglob('*') if p.is_file()]
        failures = []
        for path in files:
            data = path.read_bytes()
            text = data.decode('utf-8', errors='ignore')
            forbidden = re.search(r'/Users/|/home/|[A-Za-z]:\\Users\\|BEGIN (?:RSA |EC )?PRIVATE KEY', text)
            found = any(value.encode(enc) in data for value in private_strings
                        for enc in ('utf-8', 'utf-16le', 'utf-16be'))
            if forbidden or found:
                failures.append(str(path.relative_to(directory)))
        if failures:
            raise SystemExit(f'FAIL: {len(failures)} package files contain private path/identity data; example member: {failures[0]}')
        print(f'PASS: {package.name}: inspected {len(files)} decompressed files; no private machine paths or identity strings found.')
