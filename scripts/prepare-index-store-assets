#!/usr/bin/env python3
"""Compose native 10:08 captures with installed Garmin simulator frames."""
from pathlib import Path
import subprocess
import tempfile
import argparse
import runpy

root = Path(__file__).resolve().parents[1]
assets = root / 'mini-index/store-assets'
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--devices', type=Path, default=Path.home() / 'Library/Application Support/Garmin/ConnectIQ/Devices')
args = parser.parse_args()
devices = args.devices
checks = runpy.run_path(str(root / 'scripts/check-store-assets'))

def magick(*args):
    subprocess.run(['magick', *map(str, args)], check=True)

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    for device in ['venu3', 'venusq2']:
        # Remove simulator screen guides and the connected white canvas only.
        magick(devices/device/(device+'.png'), '-channel', 'RGB', '-fx', '((r>g+0.05)&&(b>g+0.05))?0:u', '+channel',
               '-alpha', 'on', '-fuzz', '5%', '-fill', 'none', '-draw', 'alpha 0,0 floodfill', tmp/(device+'.png'))
    for device in ['venu3', 'venusq2']:
        frame = tmp/(device+'.png')
        # Remove isolated background specks without erasing watch highlights.
        magick(frame, '-alpha', 'extract', '-threshold', '0',
               '-define', 'connected-components:area-threshold=100',
               '-define', 'connected-components:mean-color=true', '-connected-components', '8', tmp/'alpha.png')
        magick(frame, tmp/'alpha.png', '-alpha', 'off', '-compose', 'CopyOpacity', '-composite', frame)
    magick('-size', '454x454', 'xc:black', '-fill', 'white', '-draw', 'circle 227,227 227,0', tmp/'mask.png')
    results = []
    for variant in ['orange-none', 'sage-four', 'blue-twelve', 'lilac-none-date']:
        out = assets / ('screen-'+variant+'.png')
        magick(assets/'raw'/('venu3-'+variant+'.png'), tmp/'mask.png', '-alpha', 'off', '-compose', 'CopyOpacity', '-composite', tmp/'dial.png')
        magick(tmp/'venu3.png', tmp/'dial.png',
               '-geometry', '+91+206', '-compose', 'Over', '-composite',
               # Match Mini Lingua: large case, short cropped strap sections.
               '-crop', '636x667+0+100', '+repage', '-resize', '500x524!',
               '-strip', '-define', 'png:compression-level=9', out)
        results.append((out,150000))
    out = assets/'cover.png'
    magick(tmp/'venusq2.png', assets/'raw/venusq2-orange-none.png',
           '-geometry', '+123+258', '-compose', 'Over', '-composite',
           '-resize', '75%', '-crop', '431x494+0+83', '+repage',
           '-background', 'none', '-gravity', 'center', '-extent', '500x500',
           '-strip', '-define', 'png:compression-level=9', out)
    results.append((out,300000))
    for out, limit in results:
        if out.stat().st_size >= limit:
            magick(out, '-colors', '256', '-strip', out)
        assert out.stat().st_size < limit, f'{out.name} exceeds size limit'
        print(f'{out.name}: {out.stat().st_size} bytes (< {limit})')
    magick(assets/'screen-orange-none.png', assets/'screen-sage-four.png', assets/'screen-blue-twelve.png', assets/'screen-lilac-none-date.png',
           '+append', '-background', '#161616', '-alpha', 'remove', '-strip', assets/'preview.png')

errors = checks['validate'](root)
if errors:
    raise SystemExit('\n'.join(errors))
print('PASS: listing images prepared and validated.')
